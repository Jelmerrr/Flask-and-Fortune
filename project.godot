GlobalSignalBus="*res://Scripts/CoreUtils/Globals/GlobalSignalBus.gd"
GlobalItemDatabase="*uid://bukg02o2hbsae"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/mode=3
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
mouse_cursor/custom_image="uid://0r2dlwkb3wap"
mouse_cursor/custom_image_hotspot=Vector2(6, 4)

[file_customization]

folder_colors={
"res://Assets/": "blue",
"res://Resources/": "teal",
"res://Scenes/": "green",
"res://Scripts/": "pink",
"res://Shaders/": "yellow"
}

