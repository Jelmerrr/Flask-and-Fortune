GlobalIventoryHandler="*res://Scripts/Inventory/GlobalIventoryHandler.gd"
GlobalCraftingHandler="*res://Scripts/Crafting/GlobalCraftingHandler.gd"
GlobalTimeOfDayController="*res://Scripts/CoreUtils/Globals/GlobalTimeOfDayController.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://Assets/": "blue",
"res://Resources/": "teal",
"res://Scenes/": "green",
"res://Scripts/": "pink",
"res://Shaders/": "yellow"
}

