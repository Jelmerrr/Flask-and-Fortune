; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Flask and Fortune"
run/main_scene="uid://cw6yq4gb6t4dw"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="uid://blv3c2sjdg70f"

[audio]

buses/default_bus_layout="uid://oyx42t1pgnm1"

[autoload]

UtilsGlobalEnums="*res://Scripts/CoreUtils/Globals/UtilsGlobalEnums.gd"
UtilsGlobalVariables="*res://Scripts/CoreUtils/Globals/UtilsGlobalVariables.gd"
AudioController="*res://Scenes/UtilScenes/Audio/AudioController.tscn"
